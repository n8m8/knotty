# Docker ignore file for Knotty DSL
# Exclude files that shouldn't be copied to Docker context

# Version control
.git/
.gitignore
.gitattributes
.github/

# Development environment
.vscode/
.idea/
*.swp
*.swo
*~

# Build artifacts
*.o
*.so
*.dll
*.dylib
build/
dist/
target/

# Racket compiled files
compiled/
*.zo
*.dep

# Logs and temporary files
*.log
logs/
cache/
tmp/
temp/
*.tmp

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE files
*.sublime-*
.atom/
.brackets.json

# Documentation build
docs/build/
*.html
*.pdf

# Test results
test-results/
coverage/
*.coverage

# Environment variables
.env
.env.local
.env.*.local

# Package managers
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
pip-log.txt

# Large files that should be downloaded instead
*.jar
*.zip
*.tar.gz
*.dmg
*.exe

# Except our specific Saxon JAR (if it exists)
!lib/saxon-he-*.jar

# Development databases
*.db
*.sqlite
*.sqlite3

# Certificates and keys
*.pem
*.key
*.crt
*.p12
*.pfx

# Backup files
*.bak
*.backup
*~